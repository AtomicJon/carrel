#!/usr/bin/env bash
#
# carrel — run an isolated, containerised Claude Code (or opencode) in the
# current project.
#
# carrel keeps its own config dir (CARREL_HOME, default ~/.carrel), separate from
# your real ~/.claude. Selected config files are synced in on each launch;
# session history and credentials stay in CARREL_HOME. The project is mounted at
# its real host path so Claude's session IDs match a native run.
#
# Behaviour is driven by a JSON config resolved from four layers — see the
# "Configuration" section below and `carrel config --help`.

set -euo pipefail

# The one setting that can't live in the config file: it's what locates it.
CARREL_HOME="${CARREL_HOME:-$HOME/.carrel}"

VARIANTS=(base rust tauri)

# Every recognised config key. Anything else in a config file is ignored with a
# warning, and rejected outright by `carrel config set`.
CONFIG_KEYS=(variant image tz clipboard ssh_agent mounts sync)

# Fallbacks for keys no config file sets. Unlike the file layers, these never
# contribute to array concatenation — a config that sets `sync` replaces this
# list rather than appending to it.
# `tz` has no default on purpose: unset means "detect the host's", which
# host_timezone does at launch.
DEFAULT_CONFIG='{
  "variant": "base",
  "image": "carrel",
  "clipboard": false,
  "ssh_agent": "off",
  "mounts": [],
  "sync": ["CLAUDE.md", "skills", "agents", "output-styles",
           "statusline-command.sh", "notify.sh"]
}'

# Where the host's Wayland socket lands inside the container.
CLIPBOARD_SOCKET=/run/carrel/wayland.sock

# Where the forwarded ssh-agent socket lands inside the container.
SSH_AGENT_SOCKET=/run/carrel/ssh-agent.sock

# ssh_agent values: no agent, your own (SSH_AUTH_SOCK), or carrel's dedicated one.
SSH_AGENT_MODES=(off host carrel)

# Docker Desktop (macOS) can't bind host sockets into its VM, so it exposes the
# host's ssh-agent at this fixed path instead.
DOCKER_DESKTOP_SSH_SOCKET=/run/host-services/ssh-auth.sock

die() {
  echo "carrel: $*" >&2
  exit 1
}

usage() {
  local variants="${VARIANTS[*]}"
  cat <<EOF
carrel — run an isolated, containerised Claude Code in the current project.

Usage:
  carrel [variant] [claude args...]   run Claude   (variant: ${variants// /|})
  carrel shell [variant]              open a shell instead of Claude
  carrel opencode [variant] [args...] run opencode instead of Claude
  carrel config <cmd>                 read/write settings (see below)
  carrel trust                        review and trust this repo's .carrel.json
  carrel sync                         sync host config into carrel's dir
  carrel sessions [path]              print a project's session directory
  carrel -h | --help

Args after the optional variant go straight to claude, e.g.:
  carrel --resume <id>     carrel rust -c     carrel -p "summarise this repo"
Everything after -- goes to claude as-is:  carrel -- --help

Options (each overrides the config file for one run):
  -m, --mount SPEC   pass an extra host item into the container (repeatable).
                     SPEC is HOST[:CONTAINER][:ro|:rw]; read-only by default.
      --image NAME   image name / tag prefix
      --tz ZONE      container timezone
      --clipboard    forward the host's Wayland clipboard, so Ctrl-V can paste
                     images into Claude. Off by default (it hands the agent your
                     clipboard). Wayland only.
      --no-clipboard turn it back off for one run
      --ssh-agent MODE
                     forward an ssh-agent, so git can push over SSH without the
                     key entering the container. MODE is 'host' (your agent,
                     every key in it) or 'carrel' (an agent for this session
                     alone, holding only the keys in \$CARREL_HOME/ssh). Off by
                     default.
      --no-ssh-agent turn it back off for one run
      --dry-run      print the docker command that would run, and exit

Config:
  carrel config get [KEY] [--show-origin]   effective settings
  carrel config set   [--project|--repo] KEY VALUE...
  carrel config add   [--project|--repo] KEY VALUE   append to mounts / sync
  carrel config unset [--project|--repo] KEY
  carrel config path  [--project|--repo]             file that set/add would write

  --project writes your settings for this project; --repo writes the repo's
  shared .carrel.json, within the limits a repo config has.

  Keys: ${CONFIG_KEYS[*]}

  Resolved highest-precedence first:
    1. the options above
    2. \$CARREL_HOME/projects/<slug>.json    your settings for this project
    3. <project root>/.carrel.json          the repo's: restricted, and only
                                            used once you've trusted it
    4. \$CARREL_HOME/config.json             your global defaults
  Scalars override; mounts and sync accumulate across layers.

Env:
  CARREL_HOME       config dir on the host    (default: ~/.carrel)

Requires: docker, jq.
EOF
}

require_jq() {
  command -v jq >/dev/null 2>&1 ||
    die "jq is required to read the config (apt install jq / brew install jq)"
}

# ─── Configuration ────────────────────────────────────────────────────────────

# The project this run is about: the git repo we're inside, else the working
# directory. It anchors both the repo config's location and the slug that names
# your per-project config, so `carrel` behaves the same from any subdirectory.
project_root() {
  if [ -z "${PROJECT_ROOT:-}" ]; then
    PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
    [ -n "$PROJECT_ROOT" ] || PROJECT_ROOT="$PWD"
  fi
  printf '%s' "$PROJECT_ROOT"
}

# The project root with slashes turned to dashes — Claude's session-dir scheme.
project_slug() {
  local root
  root="$(project_root)"
  printf '%s' "${root//\//-}"
}

config_global_file() { printf '%s/config.json' "$CARREL_HOME"; }

# Kept beside $CARREL_HOME/claude rather than inside it: that directory is
# bind-mounted into the container, and your per-project settings are yours.
config_project_file() { printf '%s/projects/%s.json' "$CARREL_HOME" "$(project_slug)"; }

# Empty when there's no repo config to read. $HOME is excluded: a stray
# ~/.carrel.json is a global config in disguise, not a project's.
config_repo_file() {
  local root
  root="$(project_root)"
  [ "$root" = "$HOME" ] && return 0
  [ -f "$root/.carrel.json" ] || return 0
  printf '%s/.carrel.json' "$root"
}

# Where `config --repo` writes, whether or not the file exists yet.
config_repo_target() {
  local root
  root="$(project_root)"
  [ "$root" = "$HOME" ] && die "not in a project, so there's no repo config to write"
  printf '%s/.carrel.json' "$root"
}

config_scope_file() {
  case "$1" in
    project) config_project_file ;;
    repo) config_repo_target ;;
    *) config_global_file ;;
  esac
}

config_type() {
  case "$1" in
    variant | image | tz | ssh_agent) printf 'string' ;;
    clipboard) printf 'bool' ;;
    mounts | sync) printf 'array' ;;
    *) return 1 ;;
  esac
}

# {key: type} for every recognised key, as JSON.
config_types() {
  local key
  for key in "${CONFIG_KEYS[@]}"; do
    printf '%s\t%s\n' "$key" "$(config_type "$key")"
  done | jq -Rn '[inputs | split("\t") | {(.[0]): .[1]}] | add'
}

# Shared by the check and the filter below: whether a value fits its key's type.
CONFIG_VALID_DEF='
  def valid($kind):
    if $kind == "bool" then type == "boolean"
    elif $kind == "array" then type == "array" and all(.[]; type == "string")
    else type == "string" end;'

# A config file as a JSON object on stdout, or {} if it's missing, unparseable,
# or not a single object. Unknown keys and wrongly typed values are dropped, so a
# typo can't silently ride along in the merge — and a repo can't dodge a check
# on `clipboard: true` by writing `["true"]`.
read_config_file() {
  local file="$1" json types key problem
  if [ -z "$file" ] || [ ! -f "$file" ]; then
    printf '{}'
    return 0
  fi

  if ! json="$(jq -e -s 'select(length == 1 and (.[0] | type) == "object") | .[0]' \
    "$file" 2>/dev/null)"; then
    echo "carrel: ignoring $file — not a single JSON object" >&2
    printf '{}'
    return 0
  fi

  types="$(config_types)"
  while IFS=$'\t' read -r key problem; do
    [ -n "$key" ] || continue
    if [ "$problem" = unknown ]; then
      echo "carrel: ignoring unknown key '$key' in $file" >&2
    else
      echo "carrel: ignoring '$key' in $file (expected $problem)" >&2
    fi
  done < <(printf '%s' "$json" | jq -r --argjson types "$types" "$CONFIG_VALID_DEF"'
    to_entries[]
    | $types[.key] as $type
    | if $type == null then [.key, "unknown"]
      elif (.value | valid($type)) then empty
      else [.key, {bool: "true or false", array: "a list of strings",
                   string: "a string"}[$type]]
      end
    | @tsv')

  printf '%s' "$json" | jq --argjson types "$types" "$CONFIG_VALID_DEF"'
    with_entries(select($types[.key] as $type
                        | $type != null and (.value | valid($type))))'
}

# Whether a repo-committed config may ask for this mount.
#
# A .carrel.json arrives with the code — including from a repo you've only just
# cloned — so it gets to share what's inherently local to the project and
# nothing else. Named volumes (no host state) and paths inside the project pass;
# ~, $VARs, and anything resolving outside the project root don't. realpath runs
# on both sides, so a symlink planted in the repo can't point out of it.
mount_is_shareable() {
  local spec="$1" root="$2" host resolved

  spec="${spec%:ro}"
  spec="${spec%:rw}"
  host="${spec%%:*}"

  case "$host" in
    '~'* | *'$'*) return 1 ;;
  esac

  case "$host" in
    /* | ./* | ../*) ;;
    *) return 0 ;; # a named volume
  esac

  [[ "$host" == /* ]] || host="$root/$host"
  resolved="$(realpath -m "$host" 2>/dev/null)" || return 1
  root="$(realpath -m "$root" 2>/dev/null)" || return 1
  [ "$resolved" = "$root" ] || [[ "$resolved" == "$root"/* ]]
}

# A repo config as a JSON object, with everything it isn't allowed to set
# stripped out. Each removal is reported, so a repo asking for more than it can
# have is visible rather than silently ignored.
repo_config_restricted() {
  local file="$1" json root spec kept=()
  json="$(read_config_file "$file")"
  root="$(project_root)"

  # `sync` selects files out of your real ~/.claude — never a repo's call.
  if [ "$(printf '%s' "$json" | jq 'has("sync")')" = true ]; then
    echo "carrel: ignoring 'sync' in $file (only you can choose what's synced)" >&2
    json="$(printf '%s' "$json" | jq 'del(.sync)')"
  fi

  # Turning the clipboard or ssh_agent off is a hint; turning either on is a
  # decision.
  if [ "$(printf '%s' "$json" | jq '.clipboard == true')" = true ]; then
    echo "carrel: ignoring 'clipboard: true' in $file (only you can turn it on)" >&2
    json="$(printf '%s' "$json" | jq 'del(.clipboard)')"
  fi
  if [ "$(printf '%s' "$json" | jq 'has("ssh_agent") and .ssh_agent != "off"')" = true ]; then
    echo "carrel: ignoring 'ssh_agent: $(printf '%s' "$json" | jq -c '.ssh_agent')' in $file (only you can turn it on)" >&2
    json="$(printf '%s' "$json" | jq 'del(.ssh_agent)')"
  fi

  while IFS= read -r spec; do
    [ -n "$spec" ] || continue
    if mount_is_shareable "$spec" "$root"; then
      kept+=("$spec")
    else
      echo "carrel: skipping mount '$spec' in $file (outside the project);" \
        "add it with 'carrel config add --project mounts $spec'" >&2
    fi
  done < <(printf '%s' "$json" | jq -r '.mounts[]? // empty')

  printf '%s' "$json" | jq --arg kept "$(printf '%s\n' ${kept[@]+"${kept[@]}"})" \
    'if has("mounts")
       then .mounts = ($kept | split("\n") | map(select(length > 0)))
       else . end'
}

# The repo's config, restricted, and only once you've trusted it. Restrictions
# alone can't make a repo config safe — a mount can land anywhere in the
# container, including over the `claude` binary — so an unreviewed file is shown
# to you first. With no terminal to ask on, it's skipped rather than applied.
read_repo_config() {
  local file json
  file="$(config_repo_file)"
  if [ -z "$file" ]; then
    printf '{}'
    return 0
  fi

  json="$(repo_config_restricted "$file")"
  if repo_config_trusted "$file"; then
    printf '%s' "$json"
    return 0
  fi

  if [ "${CONFIG_PROMPT:-0}" = 1 ] && confirm_repo_config "$file" "$json"; then
    trust_repo_config "$file"
    printf '%s' "$json"
    return 0
  fi

  echo "carrel: not using $file until you trust it (review it with 'carrel trust')" >&2
  printf '{}'
}

# ─── Repo config trust ────────────────────────────────────────────────────────

# Trust is keyed on the file's content, so any change to it — a pull, a branch
# switch — puts it back in front of you.
file_hash() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | cut -d' ' -f1
  else
    shasum -a 256 "$1" | cut -d' ' -f1
  fi
}

trust_file() { printf '%s/projects/%s.trusted' "$CARREL_HOME" "$(project_slug)"; }

repo_config_trusted() {
  local trusted
  trusted="$(trust_file)"
  [ -f "$trusted" ] && [ "$(cat "$trusted")" = "$(file_hash "$1")" ]
}

trust_repo_config() {
  local trusted
  trusted="$(trust_file)"
  mkdir -p "$(dirname "$trusted")"
  file_hash "$1" >"$trusted"
}

# What a repo config will do, one line per setting, with each mount resolved to
# the host path or volume it actually exposes.
describe_repo_config() {
  local json="$1" key value spec resolved rest host container access
  while IFS=$'\t' read -r key value; do
    printf '    %-9s %s\n' "$key" "$value"
  done < <(printf '%s' "$json" |
    jq -r 'del(.mounts) | to_entries[] | [.key, (.value | tostring)] | @tsv')

  while IFS= read -r spec; do
    [ -n "$spec" ] || continue
    if ! resolved="$(resolve_mount "$spec" 2>/dev/null)"; then
      printf '    %-9s %s (will be skipped)\n' mount "$spec"
      continue
    fi
    rest="${resolved%:*}"
    host="${rest%%:*}"
    container="${rest#*:}"
    access=read-only
    [ "${resolved##*:}" = rw ] && access=read-write
    [[ "$host" == /* ]] || host="volume $host"
    printf '    %-9s %s -> %s (%s)\n' mount "$host" "$container" "$access"
  done < <(printf '%s' "$json" | jq -r '.mounts[]? // empty')

  if [ "$(printf '%s' "$json" | jq 'length')" = 0 ]; then
    echo "    (nothing carrel will apply)"
  fi
}

# Show a repo config and ask whether to trust it. Everything goes to stderr and
# the answer comes from stdin, since this runs inside a command substitution.
confirm_repo_config() {
  local file="$1" json="$2" reply
  {
    if [ -f "$(trust_file)" ]; then
      echo "carrel: $file has changed since you trusted it. It now asks for:"
    else
      echo "carrel: $file hasn't been reviewed yet. It asks for:"
    fi
    describe_repo_config "$json"
    printf 'carrel: trust it and continue? [y/N] '
  } >&2
  read -r reply || return 1
  case "$reply" in
    y | Y | yes) return 0 ;;
  esac
  return 1
}

cmd_trust() {
  local file json
  file="$(config_repo_file)"
  [ -n "$file" ] || die "no .carrel.json in $(project_root)"
  json="$(repo_config_restricted "$file")"

  if [ -t 0 ]; then
    confirm_repo_config "$file" "$json" || die "not trusted"
  else
    echo "carrel: trusting $file, which asks for:"
    describe_repo_config "$json"
  fi
  trust_repo_config "$file"
  echo "carrel: trusted $file"
}

# Every layer, lowest precedence first, as [{label, config}, …]. The defaults
# layer is first and is labelled so `--show-origin` can name it.
config_layers() {
  local global repo project
  global="$(config_global_file)"
  repo="$(config_repo_file)"
  project="$(config_project_file)"

  jq -n \
    --argjson defaults "$DEFAULT_CONFIG" \
    --arg globalLabel "$global" --argjson globalConfig "$(read_config_file "$global")" \
    --arg repoLabel "${repo:-(none)}" --argjson repoConfig "$(read_repo_config)" \
    --arg projectLabel "$project" --argjson projectConfig "$(read_config_file "$project")" \
    '[{label: "(default)", config: $defaults},
      {label: $globalLabel, config: $globalConfig},
      {label: $repoLabel, config: $repoConfig},
      {label: $projectLabel, config: $projectConfig}]'
}

# Fold the file layers together — later layers replace scalars and extend
# arrays — then backfill anything untouched from the defaults.
CONFIG_MERGE_FILTER='
  .[0].config + (.[1:] | reduce .[] as $layer ({};
    reduce ($layer.config | to_entries[]) as $entry (.;
      if ($entry.value | type) == "array"
        then .[$entry.key] = ((.[$entry.key] // []) + $entry.value)
        else .[$entry.key] = $entry.value
      end)))'

# Resolve every layer into CONFIG_LAYERS and CONFIG_MERGED. Call this from the
# main shell before any config_get: reading the layers is where warnings are
# emitted, and doing it once keeps a repo config's complaints from repeating per
# lookup. Subshells inherit the resolved values, so they never re-read.
config_load() {
  [ -n "${CONFIG_MERGED:-}" ] && return 0
  PROJECT_ROOT="$(project_root)"
  CONFIG_LAYERS="$(config_layers)"
  CONFIG_MERGED="$(printf '%s' "$CONFIG_LAYERS" | jq "$CONFIG_MERGE_FILTER")"
}

config_merged() { printf '%s' "${CONFIG_MERGED:-}"; }

# One key's effective value on stdout — array keys one element per line, absent
# and empty keys nothing at all.
config_get() {
  config_merged | jq -r --arg key "$1" '
    .[$key]
    | if . == null then empty
      elif type == "array" then .[]
      else . end'
}

# ─── carrel config ────────────────────────────────────────────────────────────

# Rewrite one key in a config file, creating it (and $CARREL_HOME/projects) on
# first write. Written via a temp file so an interrupted jq can't truncate a
# config you already had.
config_write() {
  local file="$1" filter="$2" tmp
  shift 2

  mkdir -p "$(dirname "$file")"
  [ -f "$file" ] || printf '{}\n' >"$file"

  tmp="$(mktemp "$file.XXXXXX")"
  if jq "$@" "$filter" "$file" >"$tmp"; then
    chmod 644 "$tmp"
    mv "$tmp" "$file"
  else
    rm -f "$tmp"
    die "failed to write $file"
  fi
}

is_ssh_agent_mode() {
  local mode
  for mode in "${SSH_AGENT_MODES[@]}"; do
    [ "$1" = "$mode" ] && return 0
  done
  return 1
}

is_variant() {
  local variant
  for variant in "${VARIANTS[@]}"; do
    [ "$1" = "$variant" ] && return 0
  done
  return 1
}

config_validate() {
  local key="$1" value="$2"
  case "$key" in
    variant)
      is_variant "$value" || die "unknown variant '$value' (want: ${VARIANTS[*]})"
      ;;
    ssh_agent)
      is_ssh_agent_mode "$value" ||
        die "ssh_agent takes one of ${SSH_AGENT_MODES[*]}, not '$value'"
      ;;
    clipboard)
      case "$value" in
        true | false) return 0 ;;
        *) die "clipboard takes true or false, not '$value'" ;;
      esac
      ;;
  esac
}

# Refuse a repo-config write that carrel would only ignore on the next launch.
config_check_repo_value() {
  local key="$1" root spec
  shift
  root="$(project_root)"
  case "$key" in
    sync)
      die "a repo config can't set 'sync' (only you can choose what's synced); use --project"
      ;;
    clipboard)
      [ "$1" = true ] &&
        die "a repo config can't turn the clipboard on; use --project"
      ;;
    ssh_agent)
      [ "$1" = off ] ||
        die "a repo config can't turn ssh_agent on; use --project"
      ;;
    mounts)
      for spec in "$@"; do
        mount_is_shareable "$spec" "$root" ||
          die "a repo config can't mount '$spec' (outside the project); use --project"
      done
      ;;
  esac
  return 0
}

# config_write, plus trust upkeep for the repo config. An edit you make yourself
# keeps a trusted (or brand new) file trusted, but never approves content you
# hadn't already reviewed.
config_write_scope() {
  local scope="$1" file="$2" keep_trust=0
  shift 2

  if [ "$scope" = repo ] && { [ ! -f "$file" ] || repo_config_trusted "$file"; }; then
    keep_trust=1
  fi

  config_write "$file" "$@"

  if [ "$scope" = repo ]; then
    if [ "$keep_trust" = 1 ]; then
      trust_repo_config "$file"
    else
      echo "carrel: $file isn't trusted yet; review it with 'carrel trust'" >&2
    fi
  fi
}

config_cmd_set() {
  local scope="$1" key="$2" type file joined
  shift 2
  type="$(config_type "$key")" || die "unknown key '$key' (want: ${CONFIG_KEYS[*]})"
  [ "$#" -gt 0 ] || die "config set needs a value for '$key'"
  [ "$scope" = repo ] && config_check_repo_value "$key" "$@"
  file="$(config_scope_file "$scope")"

  case "$type" in
    array)
      joined="$(printf '%s\n' "$@")"
      config_write_scope "$scope" "$file" \
        '.[$key] = ($value | split("\n") | map(select(length > 0)))' \
        --arg key "$key" --arg value "$joined"
      ;;
    bool)
      [ "$#" -eq 1 ] || die "'$key' takes a single value"
      config_validate "$key" "$1"
      config_write_scope "$scope" "$file" '.[$key] = ($value == "true")' \
        --arg key "$key" --arg value "$1"
      ;;
    string)
      [ "$#" -eq 1 ] || die "'$key' takes a single value"
      config_validate "$key" "$1"
      config_write_scope "$scope" "$file" '.[$key] = $value' --arg key "$key" --arg value "$1"
      ;;
  esac

  echo "carrel: set $key in $file"
}

config_cmd_add() {
  local scope="$1" key="$2" type file
  shift 2
  type="$(config_type "$key")" || die "unknown key '$key' (want: ${CONFIG_KEYS[*]})"
  [ "$type" = array ] || die "'$key' isn't a list — use 'carrel config set'"
  [ "$#" -gt 0 ] || die "config add needs a value for '$key'"
  [ "$scope" = repo ] && config_check_repo_value "$key" "$@"
  file="$(config_scope_file "$scope")"

  config_write_scope "$scope" "$file" \
    '.[$key] = ((.[$key] // []) + ($value | split("\n") | map(select(length > 0))))' \
    --arg key "$key" --arg value "$(printf '%s\n' "$@")"

  echo "carrel: added to $key in $file"
}

config_cmd_unset() {
  local scope="$1" key="$2" file
  config_type "$key" >/dev/null || die "unknown key '$key' (want: ${CONFIG_KEYS[*]})"
  file="$(config_scope_file "$scope")"
  [ -f "$file" ] || die "no config at $file"
  config_write_scope "$scope" "$file" 'del(.[$key])' --arg key "$key"
  echo "carrel: unset $key in $file"
}

# Attribute each effective value to the layer that supplied it. Array keys list
# one line per element, since a list is assembled from several layers at once.
CONFIG_ORIGIN_FILTER='
  def rows($value; $label):
    if ($value | type) == "array"
      then $value | map({value: (. | tostring), label: $label})
      else [{value: ($value | tostring), label: $label}]
    end;

  .[0].config as $defaults
  | (.[1:] | reduce .[] as $layer ({};
      reduce ($layer.config | to_entries[]) as $entry (.;
        if ($entry.value | type) == "array"
          then .[$entry.key] = ((.[$entry.key] // [])
                                + rows($entry.value; $layer.label))
          else .[$entry.key] = rows($entry.value; $layer.label)
        end))) as $set
  | (($defaults | keys) + ($set | keys) | unique)
  | map(. as $key
        | (if $set | has($key) then $set[$key]
           else rows($defaults[$key]; "(default)") end)
        | map([$key, .value, .label]))
  | (add // [])[]
  | @tsv'

config_cmd_get() {
  local show_origin="$1" key="${2:-}" key_name value label

  if [ -n "$key" ]; then
    config_type "$key" >/dev/null || die "unknown key '$key' (want: ${CONFIG_KEYS[*]})"
    if [ "$show_origin" = 1 ]; then
      printf '%s' "$CONFIG_LAYERS" | jq -r "$CONFIG_ORIGIN_FILTER" |
        while IFS=$'\t' read -r key_name value label; do
          if [ "$key_name" = "$key" ]; then
            printf '  %-24s %s\n' "$value" "$label"
          fi
        done
    else
      config_get "$key"
    fi
    return 0
  fi

  if [ "$show_origin" = 1 ]; then
    printf '%s' "$CONFIG_LAYERS" | jq -r "$CONFIG_ORIGIN_FILTER" |
      while IFS=$'\t' read -r key_name value label; do
        printf '  %-10s %-40s %s\n' "$key_name" "$value" "$label"
      done
  else
    config_merged | jq -r '
      to_entries[]
      | .key as $key
      | if (.value | type) == "array"
          then (.value[] | [$key, .])
          else [$key, (.value | tostring)]
        end
      | @tsv' |
      while IFS=$'\t' read -r key_name value; do
        printf '  %-10s %s\n' "$key_name" "$value"
      done
  fi
}

cmd_config() {
  local action="${1:-get}" scope=global show_origin=0 args=()
  [ "$#" -gt 0 ] && shift
  config_load

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --project) scope=project ;;
      --global) scope=global ;;
      --repo) scope=repo ;;
      --show-origin) show_origin=1 ;;
      *) args+=("$1") ;;
    esac
    shift
  done
  set -- ${args[@]+"${args[@]}"}

  case "$action" in
    get | path) ;;
    set | add | unset) [ "$#" -gt 0 ] || die "config $action needs a key" ;;
    *) die "unknown config command '$action' (want: get set add unset path)" ;;
  esac

  case "$action" in
    get) config_cmd_get "$show_origin" "${1:-}" ;;
    set) config_cmd_set "$scope" "$1" "${@:2}" ;;
    add) config_cmd_add "$scope" "$1" "${@:2}" ;;
    unset) config_cmd_unset "$scope" "$1" ;;
    path)
      config_scope_file "$scope"
      echo
      ;;
  esac
}

# ─── Launching ────────────────────────────────────────────────────────────────

# settings.json, with a path fixup. Commands it runs (statusLine, hooks) point at
# scripts by their host path under ~/.claude, which is mounted at
# /home/claude/.claude in the container — rewrite those so they resolve there.
# ~ and $HOME references need no fixup: they already expand correctly in the
# container. The rewritten file is compared before replacing, so an unchanged
# config stays quiet instead of reporting a sync every run.
sync_settings() {
  local src="$HOME/.claude/settings.json" dst="$CARREL_HOME/claude/settings.json"
  [ -f "$src" ] || return 0

  local tmp
  tmp="$(mktemp "$dst.XXXXXX")"
  sed "s|$HOME/.claude|/home/claude/.claude|g" "$src" >"$tmp"
  if cmp -s "$tmp" "$dst"; then
    rm -f "$tmp"
  else
    chmod 644 "$tmp"
    mv "$tmp" "$dst"
    echo "  synced settings.json"
  fi
}

# opencode's dirs, created up front so Docker doesn't create them root-owned.
# Nothing is synced: opencode already falls back to ~/.claude/CLAUDE.md and
# ~/.claude/skills, which the sync above covers.
sync_opencode() {
  mkdir -p "$CARREL_HOME/opencode/config" "$CARREL_HOME/opencode/data" \
    "$CARREL_HOME/opencode/state"
}

# One-way host -> carrel config sync, over the items the `sync` key names.
# Symlinks (e.g. dotfiles) are dereferenced so the container sees real files, not
# dangling links. Only changed files are copied, and each one is printed.
do_sync() {
  mkdir -p "$CARREL_HOME/claude"
  # Guard against a stray directory at this path (Docker creates one if the file
  # is bind-mounted before it exists), then seed an empty config if missing.
  if [ -e "$CARREL_HOME/claude.json" ] && [ ! -f "$CARREL_HOME/claude.json" ]; then
    rm -rf "$CARREL_HOME/claude.json"
  fi
  [ -f "$CARREL_HOME/claude.json" ] || echo '{}' >"$CARREL_HOME/claude.json"

  local dst="$CARREL_HOME/claude" item src
  while IFS= read -r item; do
    [ -n "$item" ] || continue
    # Items are deleted and replaced below, so they must stay inside ~/.claude.
    case "/$item/" in
      //* | */./* | */../*)
        echo "carrel: skipping sync item '$item' (must be a path inside ~/.claude)" >&2
        continue
        ;;
    esac
    src="$HOME/.claude/$item"
    [ -e "$src" ] || continue
    # Claude Code downloads claude.ai account skills into skills/synced itself,
    # so that folder is left alone: never copied from the host, never deleted.
    local owned=""
    if [ "$item" = skills ]; then
      owned=synced
    fi
    if command -v rsync >/dev/null 2>&1; then
      # -aL: archive + dereference symlinks. --delete (scoped to this item's own
      # directory, never the whole config dir) mirrors host-side removals, but
      # skips excluded paths. --out-format prints only what changed.
      if [ -d "$src" ]; then
        rsync -aL --delete ${owned:+--exclude="/$owned/"} \
          --out-format="  synced $item/%n" "$src/" "$dst/$item/"
      else
        rsync -aL --out-format='  synced %n' "$src" "$dst/"
      fi
    else
      # Fallback when rsync isn't installed: full replace, no change detection.
      local kept=""
      if [ -n "$owned" ] && [ -e "$dst/$item/$owned" ]; then
        kept="$(mktemp -d "$dst/.carrel-keep.XXXXXX")"
        mv "$dst/$item/$owned" "$kept/"
      fi
      rm -rf "${dst:?}/$item"
      cp -RL "$src" "$dst/$item" && echo "  synced $item"
      if [ -n "$owned" ]; then
        rm -rf "${dst:?}/$item/$owned"
      fi
      if [ -n "$kept" ]; then
        mv "$kept/$owned" "$dst/$item/"
        rmdir "$kept"
      fi
    fi
  done < <(config_get sync)

  sync_settings
  sync_opencode
}

# Parse one mount spec (HOST[:CONTAINER][:ro|:rw]) into a normalised
# host:container:mode string for `docker -v`, printed on stdout. Returns non-zero
# (and prints nothing) when the spec should be skipped; diagnostics go to stderr.
#
# HOST is a host path (leading ~ and $VARs expanded, ./ and ../ resolved against
# the project root) or a Docker named volume (anything else). CONTAINER defaults
# to HOST's path when omitted, but is required for named volumes. Mode defaults
# to ro — an autonomous agent runs in here, so writes are opt-in per mount.
# Specs are never eval'd, so a config line can't inject shell.
resolve_mount() {
  local spec="$1" mode host container

  case "$spec" in
    *:ro)
      mode=ro
      spec="${spec%:ro}"
      ;;
    *:rw)
      mode=rw
      spec="${spec%:rw}"
      ;;
    *) mode=ro ;;
  esac

  if [[ "$spec" == *:* ]]; then
    host="${spec%%:*}"
    container="${spec#*:}"
  else
    host="$spec"
    container=""
  fi

  # Expand a leading ~ and any $VARs in the host part (bind mounts only).
  host="${host/#\~/$HOME}"
  while [[ "$host" == *'$'* ]]; do
    local name rest="${host#*\$}"
    name="${rest%%[^A-Za-z0-9_]*}"
    [ -n "$name" ] || break
    host="${host//\$$name/${!name-}}"
  done

  # Relative specs are the repo-config idiom (./fixtures:/opt/fixtures), so they
  # anchor to the project, not to wherever you happened to run carrel.
  case "$host" in
    ./* | ../*) host="$(realpath -m "$(project_root)/$host")" ;;
  esac

  if [[ "$host" == /* ]]; then
    # Bind mount. Default the container path to the host path (the $PWD pattern).
    [ -n "$container" ] || container="$host"
    if [ ! -e "$host" ]; then
      echo "carrel: skipping mount, host path not found: $host" >&2
      return 1
    fi
  else
    # Named volume — needs an explicit absolute container target.
    if [ -z "$container" ]; then
      echo "carrel: skipping mount, volume '$host' needs a container path (VOLUME:/path)" >&2
      return 1
    fi
  fi

  printf '%s:%s:%s' "$host" "$container" "$mode"
}

# The host's IANA timezone name, printed on stdout (empty if it can't be
# determined). Debian's clock is UTC, so without this every timestamp the agent
# sees (file mtimes, git dates, the status line's usage-reset time) is offset
# from the wall clock. The `tz` config key overrides; /etc/timezone is
# Debian-style, the /etc/localtime symlink covers the rest (systemd, macOS).
host_timezone() {
  if [ -n "${TZ_OVERRIDE:-}" ]; then
    printf '%s' "$TZ_OVERRIDE"
    return 0
  fi
  if [ -n "${TZ:-}" ]; then
    printf '%s' "$TZ"
    return 0
  fi
  if [ -s /etc/timezone ]; then
    tr -d '[:space:]' </etc/timezone
    return 0
  fi

  local target
  target="$(readlink -f /etc/localtime 2>/dev/null || true)"
  case "$target" in
    */zoneinfo/*) printf '%s' "${target#*/zoneinfo/}" ;;
  esac
}

# Docker args giving the container access to the host clipboard, printed one per
# line (empty when off or unavailable).
#
# Pasting an image into Claude isn't a terminal paste — the terminal only ever
# sends text. Claude shells out to wl-paste/xclip and reads the clipboard
# itself, so the container needs its own connection to the display server.
#
# Wayland only, and deliberately opt-in: the socket lets the agent read whatever
# you copy, and write to it, for the life of the session. libwayland treats a
# WAYLAND_DISPLAY containing a slash as a literal socket path, so binding the
# socket to a fixed path avoids having to fake XDG_RUNTIME_DIR (which other
# tools in the container would then trip over). The mount is read-write because
# talking to a socket is a write.
#
# Reading the clipboard needs a compositor that implements wlr-data-control or
# ext-data-control: wlroots (Hyprland, sway), KWin, and Mutter 48+ do. Older
# GNOME doesn't expose the clipboard to Wayland clients at all, so nothing to
# forward there.
clipboard_args() {
  [ "$CLIPBOARD" = true ] || return 0

  if [ -z "${WAYLAND_DISPLAY:-}" ]; then
    echo "carrel: clipboard needs a Wayland session (WAYLAND_DISPLAY is unset); continuing without it" >&2
    return 0
  fi

  # WAYLAND_DISPLAY is a socket name inside XDG_RUNTIME_DIR, or a path already.
  local sock="$WAYLAND_DISPLAY"
  [[ "$sock" == /* ]] || sock="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/$sock"

  if [ ! -S "$sock" ]; then
    echo "carrel: clipboard found no Wayland socket at $sock; continuing without it" >&2
    return 0
  fi

  printf '%s\n' -v "$sock:$CLIPBOARD_SOCKET:rw" -e "WAYLAND_DISPLAY=$CLIPBOARD_SOCKET"
}

# Docker args giving the container an ssh-agent, printed one per line (empty
# when off or unavailable).
#
# The private key stays on the host: the container can ask the agent to sign,
# but never sees the key. It can still use every key the agent holds, against
# any server, while the session runs. The mount is read-write because talking
# to a socket is a write.
ssh_agent_args() {
  [ -n "$AGENT_SOCKET" ] || return 0
  printf '%s\n' -v "$AGENT_SOCKET:$SSH_AGENT_SOCKET:rw" -e "SSH_AUTH_SOCK=$SSH_AGENT_SOCKET"
}

# Sets AGENT_SOCKET to the host socket the configured mode forwards: your own
# agent for `host`, a per-session one for `carrel`, or empty.
resolve_agent_socket() {
  AGENT_SOCKET=""
  case "$SSH_AGENT" in
    host) AGENT_SOCKET="$(host_agent_socket)" || AGENT_SOCKET="" ;;
    carrel) prepare_carrel_agent || AGENT_SOCKET="" ;;
  esac
}

host_agent_socket() {
  if [ "$(uname -s)" = Darwin ]; then
    printf '%s' "$DOCKER_DESKTOP_SSH_SOCKET"
    return 0
  fi

  if [ -z "${SSH_AUTH_SOCK:-}" ]; then
    echo "carrel: ssh_agent 'host' needs a running ssh-agent (SSH_AUTH_SOCK is unset); continuing without it" >&2
    return 1
  fi

  if [ ! -S "$SSH_AUTH_SOCK" ]; then
    echo "carrel: ssh_agent 'host' found no socket at $SSH_AUTH_SOCK; continuing without it" >&2
    return 1
  fi

  printf '%s' "$SSH_AUTH_SOCK"
}

# Picks the keys and socket for this session's own agent: CARREL_AGENT_KEYS
# holds the private keys in $CARREL_HOME/ssh, AGENT_SOCKET a fresh socket path.
# The agent itself is started by launch_with_carrel_agent.
prepare_carrel_agent() {
  local key_dir="$CARREL_HOME/ssh" runtime_dir="${XDG_RUNTIME_DIR:-/tmp}" run_dir key
  CARREL_AGENT_KEYS=()

  if [ "$(uname -s)" = Darwin ]; then
    echo "carrel: ssh_agent 'carrel' isn't supported on macOS (Docker Desktop can only forward your own agent); continuing without it" >&2
    return 1
  fi

  if ! command -v ssh-agent >/dev/null 2>&1; then
    echo "carrel: ssh_agent 'carrel' needs ssh-agent (OpenSSH) installed; continuing without it" >&2
    return 1
  fi

  for key in "$key_dir"/id_*; do
    if [ -f "$key" ] && [ "${key%.pub}" = "$key" ]; then
      CARREL_AGENT_KEYS+=("$key")
    fi
  done
  if [ "${#CARREL_AGENT_KEYS[@]}" = 0 ]; then
    echo "carrel: ssh_agent 'carrel' found no keys in $key_dir; create one with" \
      "'ssh-keygen -t ed25519 -C carrel -f $key_dir/id_ed25519'; continuing without it" >&2
    return 1
  fi

  if [ "$dry_run" = 1 ]; then
    AGENT_SOCKET="$runtime_dir/carrel-ssh.XXXXXX/agent.sock"
    return 0
  fi

  # An agent removes its socket when it exits, so a dir left empty is from a
  # finished session. The age check spares one whose agent is still starting.
  find "$runtime_dir" -maxdepth 1 -name 'carrel-ssh.*' -type d -empty -mmin +1 -delete 2>/dev/null || true

  if ! run_dir="$(mktemp -d "$runtime_dir/carrel-ssh.XXXXXX")"; then
    echo "carrel: couldn't create a directory for carrel's ssh-agent; continuing without it" >&2
    return 1
  fi
  AGENT_SOCKET="$run_dir/agent.sock"
}

# Runs the launch command under this session's own ssh-agent, loading
# CARREL_AGENT_KEYS first (asking for any passphrase on the terminal). ssh-agent
# runs the command itself and exits once it ends, however it ends, so nothing
# the container does to the agent outlives the session. -P none refuses PKCS#11
# providers, so a request from the container can't make it load a host library.
# Docker itself runs with your own agent, as it would without carrel's.
launch_with_carrel_agent() {
  # shellcheck disable=SC2016
  exec ssh-agent -P none -a "$AGENT_SOCKET" bash -c '
    host_auth_sock="$1"
    key_count="$2"
    shift 2
    if ! ssh-add "${@:1:$key_count}" >&2; then
      echo "carrel: could not load the ssh_agent keys; not launching" >&2
      exit 1
    fi
    shift "$key_count"
    unset SSH_AGENT_PID
    if [ -n "$host_auth_sock" ]; then
      export SSH_AUTH_SOCK="$host_auth_sock"
    else
      unset SSH_AUTH_SOCK
    fi
    exec "$@"
  ' carrel-ssh-agent "${SSH_AUTH_SOCK:-}" "${#CARREL_AGENT_KEYS[@]}" "${CARREL_AGENT_KEYS[@]}" "$@"
}

# Sets SSH_KEY_DIR_ARGS to docker args hiding $CARREL_HOME/ssh behind an empty
# mount wherever a bind mount in the given docker args would otherwise carry
# carrel's private keys into the container, and refuses to launch with a mount
# from inside it. Paths are compared resolved, but the empty mount goes at the
# container path as given, which is where the keys appear.
hide_ssh_key_dir() {
  local key_dir spec host rest container real_host prefix destination
  local hidden=$'\n'
  SSH_KEY_DIR_ARGS=()
  [ -d "$CARREL_HOME/ssh" ] || return 0
  key_dir="$(realpath -m "$CARREL_HOME/ssh")"

  while [ "$#" -gt 0 ]; do
    if [ "$1" != -v ] || [ "$#" -lt 2 ]; then
      shift
      continue
    fi
    spec="$2"
    shift 2
    host="${spec%%:*}"
    rest="${spec#*:}"
    container="${rest%%:*}"
    [[ "$host" == /* ]] || continue

    real_host="$(realpath -m "$host")"
    prefix="${real_host%/}/"
    if [[ "$real_host" == "$key_dir"/* ]]; then
      die "refusing to mount $real_host: it's inside carrel's ssh key dir"
    elif [ "$key_dir" = "$real_host" ]; then
      destination="$container"
    elif [[ "$key_dir" == "$prefix"* ]]; then
      destination="${container%/}/${key_dir#"$prefix"}"
    else
      continue
    fi

    # --mount splits its value on commas and stops at a newline, so such a path
    # can't be hidden.
    case "$destination" in
      *,* | *'"'* | *$'\n'*) die "can't hide $key_dir at '$destination' in the container; rename the mount's container path" ;;
    esac
    if [[ "$hidden" != *$'\n'"$destination"$'\n'* ]]; then
      hidden+="$destination"$'\n'
      SSH_KEY_DIR_ARGS+=(--mount "type=tmpfs,destination=$destination")
    fi
  done
}

# Docker args mounting the main checkout's .git dir when running in a linked
# worktree, printed one per line (empty otherwise). A worktree's .git is only a
# file pointing into that dir, which holds the objects, refs and the worktree's
# own index, so git can't work without it. Read-write so commits work, the same
# access the project's own .git gets.
worktree_args() {
  local git_dir common_dir top back_link
  git_dir="$(git rev-parse --path-format=absolute --git-dir 2>/dev/null)" || return 0
  common_dir="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || return 0
  top="$(git rev-parse --show-toplevel 2>/dev/null)" || return 0
  [ "$git_dir" != "$common_dir" ] || return 0

  # Both paths are steered by files inside the project (.git, .git/commondir),
  # which the agent can write, so on their own they could name any repo on the
  # host. Only trust the layout `git worktree add` creates: this worktree's dir
  # sits directly under <common>/worktrees/, and the gitdir file in it, which
  # lives outside the project, points back at this worktree's .git.
  git_dir="$(realpath -e "$git_dir" 2>/dev/null)" || return 0
  common_dir="$(realpath -e "$common_dir" 2>/dev/null)" || return 0
  [ "$(dirname "$git_dir")" = "$common_dir/worktrees" ] || return 0
  back_link="$(head -n 1 "$git_dir/gitdir" 2>/dev/null)" || return 0
  [[ "$back_link" == /* ]] || back_link="$git_dir/$back_link"
  [ "$(realpath -m "$back_link")" = "$(realpath -m "$top/.git")" ] || return 0

  case "$common_dir/" in
    "$PWD"/*) return 0 ;;
  esac
  printf '%s\n' -v "$common_dir:$common_dir:rw"
}

# Claude keys session history by the project path, with slashes turned to dashes.
session_dir() {
  local p="${1:-$PWD}"
  printf '%s/claude/projects/%s\n' "$CARREL_HOME" "${p//\//-}"
}

# ─── Main ─────────────────────────────────────────────────────────────────────

# Sourced as a library (bin/carrel-vm): stop at the definitions above.
if [ "${BASH_SOURCE[0]}" != "$0" ]; then
  return 0
fi

# Help needs neither jq nor a config, so answer it before either is touched.
for arg in "$@"; do
  case "$arg" in
    --) break ;;
    -h | --help)
      usage
      exit 0
      ;;
  esac
done

require_jq

# `config` takes its own flags (--project, --show-origin), so it's dispatched
# before the launcher's flag parsing gets a look at them.
if [ "${1:-}" = config ]; then
  shift
  cmd_config "$@"
  exit 0
fi

# Pull carrel's own flags out of the args (they can sit anywhere — before or
# after a subcommand, among the claude args); everything else passes through to
# claude untouched. They're applied on top of the config once it's loaded.
flag_image=""
flag_tz=""
flag_clipboard=""
flag_ssh_agent=""
flag_ssh_agent_given=0
flag_mounts=()
dry_run=0
remaining=()
passthrough=()
while [ "$#" -gt 0 ]; do
  case "$1" in
    --)
      shift
      passthrough=("$@")
      break
      ;;
    -m | --mount)
      [ "$#" -ge 2 ] || die "--mount needs a spec"
      flag_mounts+=("$2")
      shift 2
      ;;
    --mount=*)
      flag_mounts+=("${1#--mount=}")
      shift
      ;;
    --image)
      [ "$#" -ge 2 ] || die "--image needs a name"
      flag_image="$2"
      shift 2
      ;;
    --image=*)
      flag_image="${1#--image=}"
      shift
      ;;
    --tz)
      [ "$#" -ge 2 ] || die "--tz needs a zone"
      flag_tz="$2"
      shift 2
      ;;
    --tz=*)
      flag_tz="${1#--tz=}"
      shift
      ;;
    --clipboard)
      flag_clipboard=true
      shift
      ;;
    --no-clipboard)
      flag_clipboard=false
      shift
      ;;
    --ssh-agent)
      [ "$#" -ge 2 ] || die "--ssh-agent needs a mode (host or carrel)"
      flag_ssh_agent="$2"
      flag_ssh_agent_given=1
      shift 2
      ;;
    --ssh-agent=*)
      flag_ssh_agent="${1#--ssh-agent=}"
      flag_ssh_agent_given=1
      shift
      ;;
    --no-ssh-agent)
      flag_ssh_agent=off
      flag_ssh_agent_given=1
      shift
      ;;
    --dry-run)
      dry_run=1
      shift
      ;;
    *)
      remaining+=("$1")
      shift
      ;;
  esac
done
set -- ${remaining[@]+"${remaining[@]}"}

launch=claude
case "${1:-}" in
  sessions)
    shift
    session_dir "${1:-$PWD}"
    exit 0
    ;;
  trust)
    cmd_trust
    exit 0
    ;;
  sync)
    config_load
    if [ "$dry_run" = 1 ]; then
      echo "carrel: would sync from $HOME/.claude: $(config_get sync | tr '\n' ' ')settings.json"
    else
      do_sync
    fi
    exit 0
    ;;
  shell)
    launch=shell
    shift
    ;;
  opencode)
    launch=opencode
    shift
    ;;
esac

tag=""
if is_variant "${1:-}"; then
  tag="$1"
  shift
fi

# This is the one place an unreviewed repo config is about to be acted on, so
# it's the one place carrel asks about it — and only with someone there to ask.
if [ -t 0 ] && [ -t 2 ]; then
  CONFIG_PROMPT=1
fi
config_load

IMAGE_NAME="${flag_image:-$(config_get image)}"
CLIPBOARD="${flag_clipboard:-$(config_get clipboard)}"
if [ "$flag_ssh_agent_given" = 1 ]; then
  is_ssh_agent_mode "$flag_ssh_agent" ||
    die "--ssh-agent takes one of ${SSH_AGENT_MODES[*]}, not '$flag_ssh_agent'"
  SSH_AGENT="$flag_ssh_agent"
else
  SSH_AGENT="$(config_get ssh_agent)"
  if ! is_ssh_agent_mode "$SSH_AGENT"; then
    echo "carrel: unknown ssh_agent '$SSH_AGENT' (want: ${SSH_AGENT_MODES[*]}); continuing without it" >&2
    SSH_AGENT=off
  fi
fi
TZ_OVERRIDE="${flag_tz:-$(config_get tz)}"
[ -n "$tag" ] || tag="$(config_get variant)"

# -m adds to the configured mounts rather than replacing them.
EXTRA_MOUNTS=()
while IFS= read -r spec; do
  [ -n "$spec" ] && EXTRA_MOUNTS+=("$spec")
done < <(config_get mounts)
EXTRA_MOUNTS+=(${flag_mounts[@]+"${flag_mounts[@]}"})

[ "$dry_run" = 1 ] || do_sync

mount_args=()
for spec in ${EXTRA_MOUNTS[@]+"${EXTRA_MOUNTS[@]}"}; do
  resolved="$(resolve_mount "$spec")" || continue
  mount_args+=(-v "$resolved")
done

tz_args=()
tz="$(host_timezone)"
[ -n "$tz" ] && tz_args=(-e "TZ=$tz")

clip_args=()
while IFS= read -r arg; do clip_args+=("$arg"); done < <(clipboard_args)

resolve_agent_socket
ssh_agent_mount_args=()
while IFS= read -r arg; do ssh_agent_mount_args+=("$arg"); done < <(ssh_agent_args)

worktree_mount_args=()
while IFS= read -r arg; do worktree_mount_args+=("$arg"); done < <(worktree_args)

run=(
  docker run --rm -it -w "$PWD"
  ${tz_args[@]+"${tz_args[@]}"}
  ${clip_args[@]+"${clip_args[@]}"}
  ${ssh_agent_mount_args[@]+"${ssh_agent_mount_args[@]}"}
  -v "$CARREL_HOME/claude":/home/claude/.claude
  -v "$CARREL_HOME/claude.json":/home/claude/.claude.json
  -v "$CARREL_HOME/opencode/config":/home/claude/.config/opencode
  -v "$CARREL_HOME/opencode/data":/home/claude/.local/share/opencode
  -v "$CARREL_HOME/opencode/state":/home/claude/.local/state/opencode
  -v "${IMAGE_NAME}-claude":/home/claude/.local/share/claude
  -v "${IMAGE_NAME}-opencode":/home/claude/.opencode
  -v "${IMAGE_NAME}-opencode-cache":/home/claude/.cache/opencode
  -v "${IMAGE_NAME}-node":/home/claude/.nvm/versions/node
  -v "$PWD":"$PWD"
  ${worktree_mount_args[@]+"${worktree_mount_args[@]}"}
  ${mount_args[@]+"${mount_args[@]}"}
)

# Worked out from the finished mount list, so no bind mount can skip it.
hide_ssh_key_dir "${run[@]}"
run+=(${SSH_KEY_DIR_ARGS[@]+"${SSH_KEY_DIR_ARGS[@]}"} "${IMAGE_NAME}:${tag}")

if [ "$launch" = shell ]; then
  run+=(bash)
elif [ "$launch" = opencode ]; then
  run+=(opencode "$@" ${passthrough[@]+"${passthrough[@]}"})
else
  run+=(claude "$@" ${passthrough[@]+"${passthrough[@]}"})
fi

if [ "$dry_run" = 1 ]; then
  printf '%q ' "${run[@]}"
  printf '\n'
  exit 0
fi

if [ "$SSH_AGENT" = carrel ] && [ -n "$AGENT_SOCKET" ]; then
  launch_with_carrel_agent "${run[@]}"
fi

exec "${run[@]}"
