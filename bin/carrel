#!/usr/bin/env bash
#
# carrel — run an isolated, containerised Claude Code in the current project.
#
# carrel keeps its own config dir (CARREL_HOME, default ~/.carrel), separate from
# your real ~/.claude. Selected config files are synced in on each launch;
# session history and credentials stay in CARREL_HOME. The project is mounted at
# its real host path so Claude's session IDs match a native run.

set -euo pipefail

CARREL_HOME="${CARREL_HOME:-$HOME/.carrel}"
CARREL_IMAGE="${CARREL_IMAGE:-carrel}"

# Config pulled from your real ~/.claude on each run. Credentials and session
# history are deliberately excluded. settings.json is handled separately (see
# sync_settings) because it needs a path fixup.
SYNC_ITEMS=(CLAUDE.md skills agents output-styles statusline-command.sh notify.sh)

# Extra host items to pass into the container, on top of the project itself.
# Populated from $CARREL_HOME/mounts and any -m/--mount flags. Each entry is a
# spec: HOST[:CONTAINER][:ro|:rw] — see resolve_mount below.
EXTRA_MOUNTS=()

# Whether to give the container a line to the host clipboard. Off unless asked
# for, via --clipboard or CARREL_CLIPBOARD=1 — see clipboard_args.
CLIPBOARD="${CARREL_CLIPBOARD:-0}"

# Where the host's Wayland socket lands inside the container.
CLIPBOARD_SOCKET=/run/carrel/wayland.sock

usage() {
  cat <<'EOF'
carrel — run an isolated, containerised Claude Code in the current project.

Usage:
  carrel [variant] [claude args...]   run Claude   (variant: base|rust|tauri)
  carrel shell [variant]              open a shell instead of Claude
  carrel sync                         sync host config into carrel's dir
  carrel sessions [path]              print a project's session directory
  carrel -h | --help

Args after the optional variant go straight to claude, e.g.:
  carrel --resume <id>     carrel rust -c     carrel -p "summarise this repo"

Extra mounts:
  -m, --mount SPEC   pass an extra host item into the container (repeatable).
                     SPEC is HOST[:CONTAINER][:ro|:rw]; read-only by default.
                     Standing mounts live in $CARREL_HOME/mounts (one per line).
  e.g. carrel -m ~/.ssh:/home/claude/.ssh -m ~/.gitconfig:/home/claude/.gitconfig

Clipboard:
  --clipboard        forward the host's Wayland clipboard, so Ctrl-V can paste
                     images into Claude. Off by default (it hands the agent your
                     clipboard). Wayland only. CARREL_CLIPBOARD=1 makes it
                     standing.
  --no-clipboard     override a standing CARREL_CLIPBOARD=1 for one run.

Env:
  CARREL_HOME       config dir on the host    (default: ~/.carrel)
  CARREL_IMAGE      image name / tag prefix   (default: carrel)
  CARREL_TZ         container timezone        (default: the host's)
  CARREL_CLIPBOARD  1 to forward the clipboard by default
EOF
}

# settings.json, with a path fixup. Commands it runs (statusLine, hooks) point at
# scripts by their host path under ~/.claude, which is mounted at
# /home/claude/.claude in the container — rewrite those so they resolve there.
# ~ and $HOME references need no fixup: they already expand correctly in the
# container. The rewritten file is compared before replacing, so an unchanged
# config stays quiet instead of reporting a sync every run.
sync_settings() {
  local src="$HOME/.claude/settings.json" dst="$CARREL_HOME/claude/settings.json"
  [ -f "$src" ] || return 0

  local tmp
  tmp="$(mktemp "$dst.XXXXXX")"
  sed "s|$HOME/.claude|/home/claude/.claude|g" "$src" >"$tmp"
  if cmp -s "$tmp" "$dst"; then
    rm -f "$tmp"
  else
    chmod 644 "$tmp"
    mv "$tmp" "$dst"
    echo "  synced settings.json"
  fi
}

# One-way host -> carrel config sync. Symlinks (e.g. dotfiles) are dereferenced
# so the container sees real files, not dangling links. Only changed files are
# copied, and each one is printed.
do_sync() {
  mkdir -p "$CARREL_HOME/claude"
  # Guard against a stray directory at this path (Docker creates one if the file
  # is bind-mounted before it exists), then seed an empty config if missing.
  if [ -e "$CARREL_HOME/claude.json" ] && [ ! -f "$CARREL_HOME/claude.json" ]; then
    rm -rf "$CARREL_HOME/claude.json"
  fi
  [ -f "$CARREL_HOME/claude.json" ] || echo '{}' >"$CARREL_HOME/claude.json"

  local dst="$CARREL_HOME/claude" i src
  for i in "${SYNC_ITEMS[@]}"; do
    src="$HOME/.claude/$i"
    [ -e "$src" ] || continue
    if command -v rsync >/dev/null 2>&1; then
      # -aL: archive + dereference symlinks. --delete (scoped to this item's own
      # directory, never the whole config dir) mirrors host-side removals.
      # --out-format prints only what changed.
      if [ -d "$src" ]; then
        rsync -aL --delete --out-format="  synced $i/%n" "$src/" "$dst/$i/"
      else
        rsync -aL --out-format='  synced %n' "$src" "$dst/"
      fi
    else
      # Fallback when rsync isn't installed: full replace, no change detection.
      rm -rf "$dst/$i"
      cp -RL "$src" "$dst/$i" && echo "  synced $i"
    fi
  done

  sync_settings
}

# Parse one mount spec (HOST[:CONTAINER][:ro|:rw]) into a normalised
# host:container:mode string for `docker -v`, printed on stdout. Returns non-zero
# (and prints nothing) when the spec should be skipped; diagnostics go to stderr.
#
# HOST is a host path (leading ~ and $VARs expanded) or a Docker named volume
# (no leading /). CONTAINER defaults to HOST's path when omitted, but is required
# for named volumes. Mode defaults to ro — an autonomous agent runs in here, so
# writes are opt-in per mount. Specs are never eval'd, so a config line can't
# inject shell.
resolve_mount() {
  local spec="$1" mode host container

  case "$spec" in
    *:ro)
      mode=ro
      spec="${spec%:ro}"
      ;;
    *:rw)
      mode=rw
      spec="${spec%:rw}"
      ;;
    *) mode=ro ;;
  esac

  if [[ "$spec" == *:* ]]; then
    host="${spec%%:*}"
    container="${spec#*:}"
  else
    host="$spec"
    container=""
  fi

  # Expand a leading ~ and any $VARs in the host part (bind mounts only).
  host="${host/#\~/$HOME}"
  while [[ "$host" == *'$'* ]]; do
    local name rest="${host#*\$}"
    name="${rest%%[^A-Za-z0-9_]*}"
    [ -n "$name" ] || break
    host="${host//\$$name/${!name-}}"
  done

  if [[ "$host" == /* ]]; then
    # Bind mount. Default the container path to the host path (the $PWD pattern).
    [ -n "$container" ] || container="$host"
    if [ ! -e "$host" ]; then
      echo "carrel: skipping mount, host path not found: $host" >&2
      return 1
    fi
  else
    # Named volume — needs an explicit absolute container target.
    if [ -z "$container" ]; then
      echo "carrel: skipping mount, volume '$host' needs a container path (VOLUME:/path)" >&2
      return 1
    fi
  fi

  printf '%s:%s:%s' "$host" "$container" "$mode"
}

# Load standing mount specs from $CARREL_HOME/mounts into EXTRA_MOUNTS. Blank
# lines and #-comment lines are ignored.
load_mount_file() {
  local file="$CARREL_HOME/mounts" line
  [ -f "$file" ] || return 0
  while IFS= read -r line || [ -n "$line" ]; do
    case "${line#"${line%%[![:space:]]*}"}" in
      '' | '#'*) continue ;;
    esac
    EXTRA_MOUNTS+=("$line")
  done <"$file"
}

# The host's IANA timezone name, printed on stdout (empty if it can't be
# determined). Debian's clock is UTC, so without this every timestamp the agent
# sees (file mtimes, git dates, the status line's usage-reset time) is offset
# from the wall clock. CARREL_TZ overrides; /etc/timezone is Debian-style, the
# /etc/localtime symlink covers the rest (systemd distros, macOS).
host_timezone() {
  if [ -n "${CARREL_TZ:-}" ]; then
    printf '%s' "$CARREL_TZ"
    return 0
  fi
  if [ -n "${TZ:-}" ]; then
    printf '%s' "$TZ"
    return 0
  fi
  if [ -s /etc/timezone ]; then
    tr -d '[:space:]' </etc/timezone
    return 0
  fi

  local target
  target="$(readlink -f /etc/localtime 2>/dev/null || true)"
  case "$target" in
    */zoneinfo/*) printf '%s' "${target#*/zoneinfo/}" ;;
  esac
}

# Docker args giving the container access to the host clipboard, printed one per
# line (empty when off or unavailable).
#
# Pasting an image into Claude isn't a terminal paste — the terminal only ever
# sends text. Claude shells out to wl-paste/xclip and reads the clipboard
# itself, so the container needs its own connection to the display server.
#
# Wayland only, and deliberately opt-in: the socket lets the agent read whatever
# you copy, and write to it, for the life of the session. libwayland treats a
# WAYLAND_DISPLAY containing a slash as a literal socket path, so binding the
# socket to a fixed path avoids having to fake XDG_RUNTIME_DIR (which other
# tools in the container would then trip over). The mount is read-write because
# talking to a socket is a write.
#
# Reading the clipboard needs a compositor that implements wlr-data-control or
# ext-data-control: wlroots (Hyprland, sway), KWin, and Mutter 48+ do. Older
# GNOME doesn't expose the clipboard to Wayland clients at all, so nothing to
# forward there.
clipboard_args() {
  [ "$CLIPBOARD" = 1 ] || return 0

  if [ -z "${WAYLAND_DISPLAY:-}" ]; then
    echo "carrel: --clipboard needs a Wayland session (WAYLAND_DISPLAY is unset); continuing without it" >&2
    return 0
  fi

  # WAYLAND_DISPLAY is a socket name inside XDG_RUNTIME_DIR, or a path already.
  local sock="$WAYLAND_DISPLAY"
  [[ "$sock" == /* ]] || sock="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/$sock"

  if [ ! -S "$sock" ]; then
    echo "carrel: --clipboard found no Wayland socket at $sock; continuing without it" >&2
    return 0
  fi

  printf '%s\n' -v "$sock:$CLIPBOARD_SOCKET:rw" -e "WAYLAND_DISPLAY=$CLIPBOARD_SOCKET"
}

# Claude keys session history by the project path, with slashes turned to dashes.
session_dir() {
  local p="${1:-$PWD}"
  printf '%s/claude/projects/%s\n' "$CARREL_HOME" "${p//\//-}"
}

launch=claude
case "${1:-}" in
  -h | --help)
    usage
    exit 0
    ;;
  sync)
    do_sync
    exit 0
    ;;
  sessions)
    shift
    session_dir "${1:-$PWD}"
    exit 0
    ;;
  shell)
    launch=shell
    shift
    ;;
esac

# Standing mounts from the config file load first, then any -m/--mount flags
# append — so a flag adds to (rather than replaces) the standing set.
load_mount_file

# Pull -m/--mount flags out of the remaining args (they can sit anywhere among
# the claude args); everything else passes through to claude untouched.
remaining=()
while [ "$#" -gt 0 ]; do
  case "$1" in
    -m | --mount)
      EXTRA_MOUNTS+=("${2:?carrel: --mount needs a spec}")
      shift 2
      ;;
    --mount=*)
      EXTRA_MOUNTS+=("${1#--mount=}")
      shift
      ;;
    --clipboard)
      CLIPBOARD=1
      shift
      ;;
    --no-clipboard)
      CLIPBOARD=0
      shift
      ;;
    *)
      remaining+=("$1")
      shift
      ;;
  esac
done
set -- ${remaining[@]+"${remaining[@]}"}

tag=base
case "${1:-}" in base | rust | tauri)
  tag="$1"
  shift
  ;;
esac

do_sync

mount_args=()
for spec in ${EXTRA_MOUNTS[@]+"${EXTRA_MOUNTS[@]}"}; do
  resolved="$(resolve_mount "$spec")" || continue
  mount_args+=(-v "$resolved")
done

tz_args=()
tz="$(host_timezone)"
[ -n "$tz" ] && tz_args=(-e "TZ=$tz")

clip_args=()
while IFS= read -r arg; do clip_args+=("$arg"); done < <(clipboard_args)

run=(
  docker run --rm -it -w "$PWD"
  ${tz_args[@]+"${tz_args[@]}"}
  ${clip_args[@]+"${clip_args[@]}"}
  -v "$CARREL_HOME/claude":/home/claude/.claude
  -v "$CARREL_HOME/claude.json":/home/claude/.claude.json
  -v "${CARREL_IMAGE}-claude":/home/claude/.local/share/claude
  -v "${CARREL_IMAGE}-node":/home/claude/.nvm/versions/node
  -v "$PWD":"$PWD"
  ${mount_args[@]+"${mount_args[@]}"}
  "${CARREL_IMAGE}:${tag}"
)

if [ "$launch" = shell ]; then
  exec "${run[@]}" bash
else
  exec "${run[@]}" claude "$@"
fi
